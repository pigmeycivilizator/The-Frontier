; рупор на базе НИИ отключён (патч): без музыки, тревоги и сирены.
; старые секции оставлены только ради старых сохранений:
; каждая из них сразу переводит рупор в тишину.
[logic]
active = ph_idle@off

[ph_idle@off]

[ph_idle@start]
on_info = ph_idle@off

[ph_sound@music]
snd = music
on_info = ph_idle@off

[ph_idle@night]
on_info = ph_idle@off

[ph_idle@emp]
on_info = ph_idle@off

[ph_sound@soft]
snd = alarm1
on_info = ph_idle@off

[ph_idle@soft_pause]
on_info = ph_idle@off

[ph_sound@siren]
snd = siren
looped = true
on_info = ph_idle@off
