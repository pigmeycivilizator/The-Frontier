; рупор на базе НИИ: молчит всю игру, кроме штурма.
; сирена: от начала штурма (fr_agr_assault_start) до выхода с базы (fr_agr_base_left).
; старые секции оставлены только ради старых сохранений:
; каждая из них сразу переводит рупор в ph_idle@off.
[logic]
active = ph_idle@off

[ph_idle@off]
on_info = {+fr_agr_assault_start -fr_agr_base_left} ph_sound@siren

[ph_idle@start]
on_info = ph_idle@off

[ph_sound@music]
snd = music
on_info = ph_idle@off

[ph_idle@night]
on_info = ph_idle@off

[ph_idle@emp]
on_info = ph_idle@off

[ph_sound@soft]
snd = alarm1
on_info = ph_idle@off

[ph_idle@soft_pause]
on_info = ph_idle@off

[ph_sound@siren]
snd = siren
looped = true
on_info = {+fr_agr_base_left} ph_idle@off
