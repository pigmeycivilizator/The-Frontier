[logic]
active = sr_idle@wait

[sr_idle@wait]
on_actor_inside = {+fr_agr_gear_done -fr_agr_underground_start} sr_idle@start

[sr_idle@start]
on_timer = 1000 | sr_tip1

[sr_tip1]
name = fr_agr_msg_underground
type = news
sender = default
showtime = 10000
single = true
on_signal = tip_sended | sr_idle@start2 

[sr_idle@start2]
on_timer = 5000 | nil %+fr_agr_underground_start%