-- ---------- проверки для заданий ----------
function post1_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if a:has_info("fr_wc_p1_done_1")
	   and a:has_info("fr_wc_p1_done_2")
	   and a:has_info("fr_wc_p1_done_3")
	   and a:has_info("fr_wc_p1_done_4")
	   and a:has_info("fr_wc_p1_done_5")
	   and a:has_info("fr_wc_p1_done_6") then
		return true
	end

	return false
end

-- ---------- пост 3: десять зомби и пастух ----------
function post3_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if a:has_info("fr_agr_p3_k1")
	   and a:has_info("fr_agr_p3_k2")
	   and a:has_info("fr_agr_p3_k3")
	   and a:has_info("fr_agr_p3_k4")
	   and a:has_info("fr_agr_p3_k5")
	   and a:has_info("fr_agr_p3_k6")
	   and a:has_info("fr_agr_p3_k7")
	   and a:has_info("fr_agr_p3_k8")
	   and a:has_info("fr_agr_p3_k9")
	   and a:has_info("fr_agr_p3_k10") then
		return true
	end

	return false
end

-- ---------- все три поста ----------
function posts_all_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if post1_done() and post3_done() then
		if not a:has_info("fr_agr_posts_done") then
			a:give_info_portion("fr_agr_posts_done")
		end
		return true
	end

	return false
end

