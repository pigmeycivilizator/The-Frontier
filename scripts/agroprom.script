	return false
end

-- всё задание: каждый лагерь зачищен или провален, плюс пустой лагерь Г
function patrols_all_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if (patA_done() or patA_fail())
	   and (patB_done() or patB_fail())
	   and (patC_done() or patC_fail())
	   and a:has_info("fr_agr_patD_done") then
		if not a:has_info("fr_agr_patrols_done") then
			news_manager.send_tip(a, "fr_agr_tip_patrols_done", nil, "fr_kuznetsov", nil)
			a:give_info_portion("fr_agr_patrols_done")
			patrol_reward()
		end
		return true
	end

	return false
end

-- ---------- награда за спасённые патрули ----------

local SID_PATROL_BOX = 244   -- story_id ящика у снабженца

local PATROL_DEAD_INFOS = {
	"fr_agr_patA_s1_dead", "fr_agr_patA_s2_dead", "fr_agr_patA_s3_dead",
	"fr_agr_patB_s1_dead", "fr_agr_patB_s2_dead", "fr_agr_patB_s3_dead",
	"fr_agr_patC_s1_dead", "fr_agr_patC_s2_dead", "fr_agr_patC_s3_dead",
}

-- что кладётся в ящик за каждого спасённого
local PATROL_REWARD = { "medkit_army", "ammo_5.45x39_ap" }

function patrols_saved_count()
	local n = 0
	for _, info in ipairs(PATROL_DEAD_INFOS) do
		if not has_alife_info(info) then
			n = n + 1
		end
	end
	return n
end

-- ящик у снабженца + личное сообщение Роговцу через 12 секунд после общего
function patrol_reward()
	local a = db.actor
	if not a or a:has_info("fr_agr_patrol_reward") then return end
	a:give_info_portion("fr_agr_patrol_reward")

	local n = patrols_saved_count()
	if n == 0 then return end

	local sim = alife()
	local box = sim:story_object(SID_PATROL_BOX)
	if box then
		for i = 1, n do
			for _, sec in ipairs(PATROL_REWARD) do
				sim:create(sec, box.position, box.m_level_vertex_id, box.m_game_vertex_id, box.id)
			end
		end
		if n == #PATROL_DEAD_INFOS then
			sim:create("medkit_scientic", box.position, box.m_level_vertex_id, box.m_game_vertex_id, box.id)
			sim:create("medkit_scientic", box.position, box.m_level_vertex_id, box.m_game_vertex_id, box.id)
			sim:create("medkit_scientic", box.position, box.m_level_vertex_id, box.m_game_vertex_id, box.id)
		end
	end

	if n == #PATROL_DEAD_INFOS then
		news_manager.send_tip(a, "fr_agr_tip_patrol_thanks_all", 12, "fr_kuznetsov", 10000)
	else
		news_manager.send_tip(a, "fr_agr_tip_patrol_thanks", 12, "fr_kuznetsov", 10000)
	end
end

