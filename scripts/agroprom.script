end

-- финал Ордена: пока пусто, ролик добавишь сам
function order_end()
end

-- ЭМИ: электроника мертва (КПК, фонарь, консоль, прицел)
function emp_devices_off()
	force_torch_off()
	level.block_action(key_bindings.kMAP)
	level.block_action(key_bindings.kACTIVE_JOBS)
	level.block_action(key_bindings.kCONTACTS)
	level.block_action(key_bindings.kCONSOLE)
	level.block_action(key_bindings.kTORCH)
	get_console():execute("hud_crosshair 0")
end

-- конец ЭМИ: всё возвращается
function emp_devices_on()
	level.unblock_action(key_bindings.kMAP)
	level.unblock_action(key_bindings.kACTIVE_JOBS)
	level.unblock_action(key_bindings.kCONTACTS)
	level.unblock_action(key_bindings.kCONSOLE)
	level.unblock_action(key_bindings.kTORCH)
	get_console():execute("hud_crosshair 1")
end

-- Забрать КПК у игрока и отключить интерфейс
function take_pda_disable_ui(first_speaker, second_speaker)
	emp_devices_off()
	level.set_weather("default_np_foggy_nosun", true)
	get_console():execute("hud_draw 0")
end

-- Вернуть КПК и включить интерфейс обратно
function give_pda_enable_ui(first_speaker, second_speaker)
	emp_devices_on()
	level.set_weather("default_np_alpha", true)
	get_console():execute("hud_draw 1")
end

