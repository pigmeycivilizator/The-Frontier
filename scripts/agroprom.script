-- ============================================================

local EMP_CAM_ID    = 9151
local EMP_FLASH_ID  = 9152
local EMP_BLINK_ID  = 9153
local SHOT_BLINK_ID = 9154

-- "Я сказал, прочь с дороги!": диалог обрывается, выстрел, Хорус пропадает,
-- на его месте появляется труп зомби (спавнер на fr_agr_horus_gone)
function horus_refuse_shot(first_speaker, second_speaker)
	dialogs.break_dialog(first_speaker, second_speaker)
	play2d("weapons\\_gunfire\\mono\\trg\\Close_1")
	level.add_pp_effector("blink.ppe", SHOT_BLINK_ID, false)
	db.actor:give_info_portion("fr_agr_horus_gone")
end

-- прибор установлен: управление забрано, антенна гудит
function emp_charge()
	level.disable_input()
	play2d("anomaly\\electra_blast1")
	play2d("anomaly\\electra_blast1", 2.5)
	level.add_cam_effector("camera_effects\\earthquake.anm", EMP_CAM_ID, false, "")
end

-- импульс: вспышка, звон в ушах, глаза закрываются
function emp_blast()
	level.add_pp_effector("teleport.ppe", EMP_FLASH_ID, false)
	play2d("affects\\tinnitus3a")
	level.add_pp_effector("blink.ppe", EMP_BLINK_ID, false)
end

-- пока экран тёмный: прошло время, туман, электроника и худ мертвы
function emp_blackout()
	emp_devices_off()
	get_console():execute("hud_draw 0")
	weather_emp()
	if not db.actor:has_info("fr_agr_emp_start") then
		db.actor:give_info_portion("fr_agr_emp_start")
		digger_stash_fill()
	end
end

-- Роговец приходит в себя
function emp_wake()
	level.enable_input()
	level.add_cam_effector("camera_effects\\earthquake.anm", EMP_CAM_ID, false, "")
	play2d("affects\\psy_blackout_l")
end

