local SID_CULTIST = 236

local PSI_PP_ID   = 9141
local PSI_CAM_ID  = 9142
local VOICE_PP_ID = 9143

local strike_snd = {}

local function play2d(path, delay)
	local s = sound_object(path)
	table.insert(strike_snd, s)
	s:play(db.actor, delay or 0, sound_object.s2d)
end

-- счётчик убийств, хранится в сейве актора
function kill_add(key)
	local a = db.actor
	if not a then return end
	local k = "fr_kc_" .. key
	xr_logic.pstor_store(a, k, xr_logic.pstor_retrieve(a, k, 0) + 1)
end

function kill_count(key)
	local a = db.actor
	if not a then return 0 end
	return xr_logic.pstor_retrieve(a, "fr_kc_" .. key, 0)
end

-- функции заданий
function strike_note_taken(actor, npc)
	local a = db.actor
	if a and a:object("fr_agr_strike_note") then
		if not a:has_info("fr_agr_strike_note_taken") then
			a:give_info_portion("fr_agr_strike_note_taken")
		end
		return true
	end
	return false
end

function devices_taken(actor, npc)
	local a = db.actor
	if a and sak.have_item_namber("fr_agr_pvm14", 3) then
		if not a:has_info("fr_agr_devices_found") then
			a:give_info_portion("fr_agr_devices_found")
		end
		return true
	end
	return false
end

local SID_BROTHER = 237

-- логово зачищено: записка и приборы в трупе культиста, запасной ПКМ в трупе брата
function strike_cleared()
	local a = db.actor
	if not a or a:has_info("fr_agr_strike_cleared") then return end

	local sim = alife()
	local se = sim:story_object(SID_CULTIST)
	if se then
		local items = { "fr_agr_strike_note", "fr_agr_pvm14", "fr_agr_pvm14", "fr_agr_pvm14" }
		for _, sec in ipairs(items) do
			sim:create(sec, se.position, se.m_level_vertex_id, se.m_game_vertex_id, se.id)
		end
	end

	local br = sim:story_object(SID_BROTHER)
	if br then
		sim:create("wpn_pkm", br.position, br.m_level_vertex_id, br.m_game_vertex_id, br.id)
	end

	a:give_info_portion("fr_agr_strike_cleared")
end

-- записка взята: пси-удар (только эффекты, управление забирает катсцена)
function strike_psi()
	level.add_pp_effector("radar_psi.ppe", PSI_PP_ID, false)
	level.add_cam_effector("camera_effects\\earthquake.anm", PSI_CAM_ID, false, "")
	play2d("fr\\agroprom\\strike_psi")
end

function strike_voice()
	play2d("fr\\agroprom\\strike_voice")
	level.add_pp_effector("radar_psi.ppe", VOICE_PP_ID, false)
end

local function strike_burst(path, start, count, step)
	for i = 0, count - 1 do
		play2d(path .. math.random(1, 4), start + i * step)
	end
end

function strike_shots()
	play_burst("weapons\\_gunfire\\mono\\trg\\Close_",  0.0,  6, 0.10)
end

-- предатель становится врагом игроку и отряду
function traitor_turn(npc)
	npc:set_character_community("monolith", 0, 0)
	if db.actor then
		npc:set_relation(game_object.enemy, db.actor)
	end
end


