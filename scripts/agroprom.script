-- ---------- засада разведки ----------

-- разговор обрывается, спокойный разведчик падает замертво,
-- трое остальных становятся врагами по поршню в своей логике
-- ===================== ЗАСАДА РАЗВЕДКИ =====================

local recon_shots = {}

-- очередь: count выстрелов с интервалом step секунд, начиная через start секунд
local function play_burst(path, start, count, step)
	for i = 0, count - 1 do
		local snd = sound_object(path .. math.random(1, 4))
		table.insert(recon_shots, snd)
		snd:play(db.actor, start + i * step, sound_object.s2d)
	end
end

function recon_ambush(first_speaker, second_speaker)
	dialogs.break_dialog(first_speaker, second_speaker)

	recon_shots = {}
	play_burst("weapons\\_gunfire\\mono\\trg\\Close_",  0.0,  6, 0.10)


	local npc = level_object_by_sid(223)
	if npc == nil then
		return
	end

	local h = hit()
	h.power = 100
	h.direction = npc:direction()
	h.draftsman = npc
	h.impulse = 1
	h.type = hit.wound
	npc:hit(h)

	relation_registry.set_community_goodwill("killer", db.actor:id(), -5000)
end

