-- ===================== МЫСЛИ ГГ =====================

local thought_id = "fr_thought"

local function thought_show(text, seconds)
	local hud = get_hud()
	if not hud then return end

	local cs = hud:GetCustomStatic(thought_id)
	if cs == nil then
		cs = hud:AddCustomStatic(thought_id, true)
	end

	cs:wnd():SetTextST(text)
	cs.m_endTime = time_global() / 1000 + seconds
end

-- text - id строки из string table (или просто текст), seconds - сколько висит
-- если игрок в диалоге или в КПК, мысль дождётся, пока он их закроет
function thought(text, seconds)
	seconds = seconds or 7

	if xr_conditions.can_send_tutorial() then
		thought_show(text, seconds)
	else
		level.add_call(
			function() return xr_conditions.can_send_tutorial() end,
			function() thought_show(text, seconds) end
		)
	end
end

function thought_hide()
	local hud = get_hud()
	if hud and hud:GetCustomStatic(thought_id) then
		hud:RemoveCustomStatic(thought_id)
	end
end

