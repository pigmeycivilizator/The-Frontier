local ORDER_GEAR = {
	{ "wpn_pkm",         1, true  },
	{ "ammo_pkm_100",    6, true },
	{ "exo_outfit",      1, true  },
	{ "medkit_scientic", 5, true },
	{ "bandage",         5, true },
	{ "grenade_f1",      3, true },
}

function order_gear(first_speaker, second_speaker)
	for _, it in ipairs(ORDER_GEAR) do
