-- Поставить сюжетную погоду и запустить цикл с этого места.
-- period  - период из dynamic_weather_graphs.ltx: "1_good", "2_neutral", "3_alpha", "4_bad", "5_foggy"
-- weather - погода из этого периода, без "default_": "np_clear2", "np_thunder" и т.д.
-- hold    - сколько игровых часов держится этот период, дальше цикл идёт сам
function set_story_weather(period, weather, hold)
	local binder = db.actor and db.actor:binded_object()
	local wm = binder and binder.weather_manager
	if not wm then return end

	local h = level.get_time_hours()

	wm.current_period = period
	wm.transition_period = false
	wm.pre_blowout_period = false
	wm.levelWeather = period
	wm.last_period_change_hour = h
	wm.next_period_change_hour = math.mod(h + hold, 24)
	wm.last_hour = h
	wm.state = {}
	wm.state[period] = {
		current_state = weather,
		next_state = weather,
		graph_name = period,
		graph = wm:get_graph_by_name(period)
	}

	level.set_weather("default_"..weather, true)
end


-- 1. Старт, диалог с раненым бойцом. 07:30, пасмурное утро без дождя
function weather_start(a, b)
	get_console():execute("hud_draw 1")
	get_console():execute("hud_crosshair 1")
	set_story_weather("3_alpha", "np_alpha3", 3)
end

-- 2. После первой встречи с Серым. 11:30, ясно
function weather_sery(a, b)
	set_game_time(11, 30)
	set_story_weather("1_good", "np_clear2", 4)
end

-- 3. После доклада Кузнецову о бое с зомби. 17:00, облачный вечер, ночью красная луна
function weather_kuznetsov_report(a, b)
	set_game_time(17, 0)
	set_story_weather("2_neutral", "np_cloudy2_redmoon", 5)
end

-- 4. ЭМИ. 20:30, густой туман без солнца
function weather_emp(a, b)
	set_game_time(20, 30)
	set_story_weather("5_foggy", "np_foggy_nosun", 4)
end

-- 5. Выход из тоннеля. 23:00, ясная ночь (игрок ещё без ПНВ)
function weather_tunnel_exit(a, b)
	set_game_time(23, 0)
	set_story_weather("1_good", "np_clear3", 2)
end

-- 6. После разговора с Серым. Гроза, без ПНВ почти ничего не видно
function weather_dark(a, b)
	set_story_weather("4_bad", "np_cloudy", 4)
end


