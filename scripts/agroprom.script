	dialogs.relocate_item_section(first_speaker, "ammo_12x70_buck", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_12x70_buck", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_12x76_zhekan", "in")
