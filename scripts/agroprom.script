function sery_take_case(first_speaker, second_speaker)
	sak.out_item_namber("fr_agr_kuz_case", 1)

	-- Хорус в будке исчезает после разговора с Серым
	local se = alife():story_object(222)
	if se ~= nil then
		alife():release(se, true)
	end
end