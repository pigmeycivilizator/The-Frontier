-- на втором вызове под шипение подкладывается голос с поляны
function ghost_call(n)
	play2d("fr\\agroprom\\radio_static")
	level.add_pp_effector("radar_psi.ppe", GHOST_PP_ID, false)
	if tonumber(n) == 2 then
		play2d("fr\\agroprom\\chant", 1)
	end
end

-- конец ЭМИ: электроника и худ возвращаются
function emp_end()
	local a = db.actor
	if not a or a:has_info("fr_agr_emp_end") then return end
	a:give_info_portion("fr_agr_emp_end")
	emp_devices_on()
	get_console():execute("hud_draw 1")
	play2d("fr\\agroprom\\radio_static")
end

-- сигнал Кузнецова сквозь помехи
function kuz_signal(n)
	news_manager.send_tip(db.actor, "fr_agr_tip_kuz_signal_" .. n, nil, "fr_kuznetsov", 9000)
end

function emp_active()
	return has_alife_info("fr_agr_emp_start") and not has_alife_info("fr_agr_emp_end")
end

-- каждый кадр (из nvd_mask_update):
-- 1) после загрузки сейва заново ставит или снимает блокировки ЭМИ
-- 2) во время ЭМИ разрешает ПНВ только в костюме диггеров
local emp_checked = false

function emp_update()
	if emp_checked or not db.actor then return end
	emp_checked = true

	emp_devices_on()
	if emp_active() then
		emp_devices_off()
		get_console():execute("hud_draw 0")
	else
		get_console():execute("hud_draw 1")
	end
end

-- пост 3: обе химеры убиты
function p3_chimeras_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if a:has_info("fr_agr_p3_ch_k1")
	   and a:has_info("fr_agr_p3_ch_k2") then
		return true
	end

	return false
end

-- пост 2: все четыре предателя убиты
function p2_traitors_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if a:has_info("fr_agr_p2_tr_k1")
	   and a:has_info("fr_agr_p2_tr_k2")
	   and a:has_info("fr_agr_p2_tr_k3")
	   and a:has_info("fr_agr_p2_tr_k4") then
		return true
	end

	return false
end

-- ============================================================
-- Квесты 35-42: лазарет, предатели, Кузнецов, снабженец,
-- подземка, сержант, вход в П-2
-- ============================================================

local SAB_SIDS      = { 246, 247, 248, 249 } 
local UND_ENEMIES   = 15                      -- сколько врагов в подземке (Орден + предатели)
local UND_DEFENDERS = 8                       -- сколько военных защищает подземку

-- игрок отказал: диалог закрывается, NPC получает смертельный хит
-- диалог всегда начинает игрок, поэтому NPC это second_speaker
function npc_let_die(first_speaker, second_speaker)
	dialogs.break_dialog(first_speaker, second_speaker)
	second_speaker:kill(second_speaker)
end

-- ---------- лазарет ----------

function laz_can_heal(first_speaker, second_speaker)
	return sak.have_item_namber("medkit_army", 1) and sak.have_item_namber("bandage", 1)
end

function laz_heal(first_speaker, second_speaker)
	sak.out_item_namber("medkit_army", 1)
	sak.out_item_namber("bandage", 1)
end

function laz_saved_count()
	local n = 0
	for i = 1, 4 do
		if has_alife_info("fr_agr_laz_w" .. i .. "_saved") then
			n = n + 1
		end
	end
	return n
end

-- все четверо либо спасены, либо умерли
function laz_all_done(actor, npc)
	for i = 1, 4 do
		if not has_alife_info("fr_agr_laz_w" .. i .. "_saved")
		   and not has_alife_info("fr_agr_laz_w" .. i .. "_dead") then
			return false
		end
	end
	return true
end

function laz_all_saved(first_speaker, second_speaker)
	return laz_saved_count() == 4
end

function laz_not_all_saved(first_speaker, second_speaker)
	return laz_saved_count() < 4
end

-- награда дежурного: за каждого спасённого пачка 5.45 и РГД
function laz_reward(first_speaker, second_speaker)
	local n = laz_saved_count()
	if n == 0 then
		dialogs.relocate_item_section(first_speaker, "grenade_rgd5", "in")
		dialogs.relocate_item_section(first_speaker, "grenade_rgd5", "in")
		return
	end
	for i = 1, n do
		dialogs.relocate_item_section(first_speaker, "ammo_5.45x39_fmj", "in")
	end
	if n == 4 then
		dialogs.relocate_item_section(first_speaker, "grenade_f1", "in")
		dialogs.relocate_item_section(first_speaker, "grenade_f1", "in")
	end
end

-- ---------- предатели у склада ----------

-- по первому попаданию все четверо становятся врагами только игроку
function base_saboteurs_turn()
	local a = db.actor
	if not a or a:has_info("fr_agr_sab_turned") then return end
	a:give_info_portion("fr_agr_sab_turned")

	for _, sid in ipairs(SAB_SIDS) do
		local npc = level_object_by_sid(sid)
		if npc and npc:alive() then
			pcall(function() npc:force_set_goodwill(-10000, a) end)
			npc:set_relation(game_object.enemy, a)
		end
	end
end

function base_saboteurs_done(actor, npc)
	local a = db.actor
	if not a then return false end
	return a:has_info("fr_agr_sab_k1")
	   and a:has_info("fr_agr_sab_k2")
	   and a:has_info("fr_agr_sab_k3")
	   and a:has_info("fr_agr_sab_k4")
end

-- ---------- снабженец ----------

function snab_final_gear(first_speaker, second_speaker)
	dialogs.relocate_item_section(first_speaker, "military_outfit", "in")
	dialogs.relocate_item_section(first_speaker, "wpn_groza", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_9x39_pab9", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_9x39_pab9", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_9x39_ap", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_9x39_ap", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_vog-25", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_vog-25", "in")
	dialogs.relocate_item_section(first_speaker, "ammo_vog-25", "in")

end

-- ---------- подземка ----------

function und_enemies_done(actor, npc)
	return kill_count("und") >= UND_ENEMIES
end

-- выжило больше половины защитников (для реплик наверху)
function und_def_held()
	local alive = UND_DEFENDERS - kill_count("und_def")
	return alive * 2 > UND_DEFENDERS
end

-- ---------- сержант ----------

function serg_can_heal(first_speaker, second_speaker)
	return sak.have_item_namber("medkit_scientic", 1)
end

function serg_heal(first_speaker, second_speaker)
	sak.out_item_namber("medkit_scientic", 1)
end

-- спасён (поршень из диалога) или погиб и игрок подобрал его КПК
function serg_final_done(actor, npc)
	local a = db.actor
	if not a then return false end
	if a:has_info("fr_agr_serg_final_done") then return true end

	local pda = sak.have_item_namber("fr_agr_serg_pda", 1)
	if pda and not a:has_info("fr_agr_serg_pda_taken") then
		a:give_info_portion("fr_agr_serg_pda_taken")
	end

	if pda or a:has_info("fr_agr_serg_final_saved") then
		a:give_info_portion("fr_agr_serg_final_done")
		return true
	end
	return false
end

-- ============================================================
-- Квесты 43-45: П-2, карты, Фанат, выход на поверхность
-- ============================================================

-- карты у игрока
function maps_taken(actor, npc)
	local a = db.actor
	if not a then return false end
	if a:has_info("fr_agr_maps_taken") then return true end
	if sak.have_item_namber("fr_agr_maps_final", 1) then
		a:give_info_portion("fr_agr_maps_taken")
		return true
	end
	return false
end

-- после смерти Фаната: пси-удар и голос Хоруса
function p2_psi_call()
	strike_psi()
	play2d("fr\\agroprom\\kill_them_all", 1)
end


-- ============================================================
-- Квесты 46-51: штурм базы и побег
-- ============================================================

local W1_TOTAL   = 28     -- зомбированных в первой волне
local W2_TOTAL   = 28     -- диких у северного входа
local W3_TOTAL   = 26     -- орденовцев с холмов
local SNIP_TOTAL = 2      -- вражеских снайперов на холме
local WAVE_PART  = 0.5   -- какую часть волны нужно перебить

local SID_ROOF_SNIPER = 255   -- наш снайпер на крыше
local SID_SNAB2       = 256   -- сержант-снабженец в кабинете полковника
local SID_SNIPER_BOX = 260

local SNIPER_GUN  = "wpn_svd"            -- СВД с ночным прицелом из пака
local SNIPER_AMMO = "ammo_7.62x54_7h1"
local SNIPER_SCOPE = "1pn93-4"
local SHOT_SND    = "weapons\\_gunfire\\mono\\trg\\Close_1"  -- поставь звук СВД

local function give_info_once(info)
	local a = db.actor
	if a and not a:has_info(info) then
		a:give_info_portion(info)
	end
end

local function wave_need(total)
	return math.ceil(total * WAVE_PART)
end

-- ---------- волны ----------

function w1_done(actor, npc)
	if kill_count("w1") >= wave_need(W1_TOTAL) then
		give_info_once("fr_agr_w1_done")
		return true
	end
	return false
end

function w2_done(actor, npc)
	if kill_count("w2") >= wave_need(W2_TOTAL) then
		give_info_once("fr_agr_w2_done")
		return true
	end
	return false
end

-- третья волна: считаются только убийства игрока
function w3_done(actor, npc)
	if kill_count("w3") >= wave_need(W3_TOTAL) then
		give_info_once("fr_agr_w3_done")
		return true
	end
	return false
end

-- ---------- снайперы и карты ----------

function snipers_done(actor, npc)
	return kill_count("snip") >= SNIP_TOTAL
end

function kuz_maps_taken(actor, npc)
	return sak.have_item_namber("fr_agr_maps_kuz", 1)
end

function q50_done(actor, npc)
	if snipers_done() and kuz_maps_taken() then
		give_info_once("fr_agr_q50_done")
		return true
	end
	return false
end

-- ---------- события штурма ----------

-- взрывы под стенами
function assault_wall_boom()
	play2d("weapons\\_boom\\mono\\vehicle\\medium_distance_1")
	play2d("weapons\\_boom\\mono\\frag\\medium_distance_2", 1.1)
	play2d("weapons\\_boom\\mono\\frag\\medium_distance_1", 1.5)
	play2d("weapons\\_boom\\mono\\frag\\medium_distance_2", 1.9)
end

-- нашего снайпера на крыше выбили: в трупе СВД и патроны
function sniper_down()
	play2d(SHOT_SND)
	local npc = level_object_by_sid(SID_ROOF_SNIPER)
	if npc and npc:alive() then
		npc:kill(npc)
	end

	local box = level_object_by_sid(SID_SNIPER_BOX)
	if box then
		local sim = alife()
		local items = { SNIPER_GUN, SNIPER_AMMO, SNIPER_AMMO, SNIPER_AMMO, SNIPER_AMMO, SNIPER_AMMO, SNIPER_SCOPE }
		for _, sec in ipairs(items) do
			sim:create(sec, box:position(), box:level_vertex_id(), box:game_vertex_id(), box:id())
		end
	end
end

-- сержанта в кабинете снимает снайпер
function snab2_down()
	play2d(SHOT_SND)
	local npc = level_object_by_sid(SID_SNAB2)
	if npc and npc:alive() then
		npc:kill(npc)
	end
end

-- реплики спасённых: лазарет и подземка
function assault_reports()
	local laz = laz_saved_count()
	local laz_id = "fr_agr_tip_rep_laz_none"
	if laz >= 3 then
		laz_id = "fr_agr_tip_rep_laz_good"
	elseif laz >= 1 then
		laz_id = "fr_agr_tip_rep_laz_some"
	end
	news_manager.send_tip(db.actor, laz_id, nil, nil, 10000)

	local serg = has_alife_info("fr_agr_serg_final_saved")
	local held = und_def_held()
	local und_id
	if serg and held then
		und_id = "fr_agr_tip_rep_und_serg_held"
	elseif serg then
		und_id = "fr_agr_tip_rep_und_serg_lost"
	elseif held then
		und_id = "fr_agr_tip_rep_und_noserg_held"
	else
		und_id = "fr_agr_tip_rep_und_noserg_lost"
	end
	news_manager.send_tip(db.actor, und_id, 13, nil, 10000)
end