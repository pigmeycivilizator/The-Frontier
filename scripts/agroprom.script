function wc1_complete()
	if db.actor ~= nil then
		if has_alife_info("wc1_s1_done") and has_alife_info("wc1_s2_done")
		   and has_alife_info("wc1_s3_done") and has_alife_info("wc1_s4_done")
		   and has_alife_info("wc1_s5_done")
		then
			db.actor:give_info_portion("wc_check1_done")
		return true
		end
	end
	return false
end

function wc2_complete()
	if db.actor ~= nil then
		if has_alife_info("wc2_s1_done") and has_alife_info("wc2_s2_done")
		   and has_alife_info("wc2_s3_done") and has_alife_info("wc2_s4_done")
		   and has_alife_info("wc2_s5_done") and has_alife_info("wc2_s6_done")
		then
			db.actor:give_info_portion("wc_check2_done")
		return true
		end
	end
	return false
end


function cam_earthquake()
	level.add_cam_effector("camera_effects\\earthquake.anm", 9101, false, "")
end

function fx_radar_psi()
       level.add_pp_effector("radar_psi.ppe", 9005, false)
end
