-- лагерь A: зомби перебиты
function patA_done(actor, npc)
	local a = db.actor
	if not a then return false end

	if a:has_info("fr_agr_pA_k1")
	   and a:has_info("fr_agr_pA_k2")
	   and a:has_info("fr_agr_pA_k3")
	   and a:has_info("fr_agr_pA_k4")
	   and a:has_info("fr_agr_pA_k5")
	   and a:has_info("fr_agr_pA_k6") then
		return true
	end

	return false
end

