-- ---------- засада разведки ----------

-- разговор обрывается, спокойный разведчик падает замертво,
-- трое остальных становятся врагами по поршню в своей логике
function recon_ambush(first_speaker, second_speaker)
	dialogs.break_dialog(first_speaker, second_speaker)

	local npc = level_object_by_sid(223)
	if npc == nil then
		return
	end
	local h = hit()
	h.power = 100
	h.direction = npc:direction()
	h.draftsman = npc
	h.impulse = 1
	h.type = hit.wound
	npc:hit(h)
	
    relation_registry.set_community_goodwill("killer", db.actor:id(), -5000)
	
end

