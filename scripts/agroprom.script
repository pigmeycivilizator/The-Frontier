function wc_all_done(actor, npc)
	local a = db.actor
	if not a then return false end
	for i = 1, 8 do
		if not a:has_info("fr_wc_done_" .. i) then return false end
	end
	return true
end

-- ---------- проверки для заданий ----------

function north_items_found(actor, npc)
	local a = db.actor
	if not a then return false end
	if not sak.have_item_namber("fr_agr_maps_part", 1) then return false end
	if not sak.have_item_namber("fr_agr_cult_pda", 1) then return false end

	if not a:has_info("fr_agr_north_checked") then
		a:give_info_portion("fr_agr_north_checked")
	end
	return true
end

function und_requests_done(actor, npc)
	local a = db.actor
	if not a then return false end
	if not wc_all_done()                      then return false end
	if not a:has_info("fr_agr_krovosos_done") then return false end
	if not a:has_info("fr_agr_pistol_done")   then return false end
	if not a:has_info("fr_agr_north_done")    then return false end

	if not a:has_info("fr_agr_und_requests_done") then
		a:give_info_portion("fr_agr_und_requests_done")
	end
	return true
end

